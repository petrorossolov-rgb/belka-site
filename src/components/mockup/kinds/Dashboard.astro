---
// Вид `dashboard` (дашборд Belka Analytics): минимальный вид до T12/T13 — рамка с приложением и экраном. Строк нет:
// всё приходит из данных мокапа (`src/content/mockups/*.yaml`).
import WindowFrame from '../ui/WindowFrame.astro';
import type { MockupOf } from '../kinds';

interface Props {
  mockup: MockupOf<'dashboard'>;
}

const { mockup } = Astro.props;
---

<WindowFrame app={mockup.app} screen={mockup.screen} />
