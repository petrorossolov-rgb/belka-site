---
// SEO-слой страницы (T21): заголовок, описание, noindex вне прода (T16), canonical,
// Open Graph, `twitter:card` и JSON-LD `Organization`. Правила — в `lib/seo.ts`.
// Canonical и абсолютные URL — от `site.yaml → url` в любом окружении.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE_ENV } from 'astro:env/server';
// Знак здесь не выводится на страницу (это делает только `Logo.astro`): нужен лишь URL
// растра для `logo` в JSON-LD. Растр не перекрашивается и не обрезается.
import mark from '../assets/brand/mark-rust.png';
import { getSite } from '../lib/content';
import { logoLayout, maxLogoHeight } from '../lib/logo';
import { assetUrl, canonicalUrl, organizationJsonLd, previewImage, serializeJsonLd, socialMeta } from '../lib/seo';
import { indexable } from '../lib/site-env';

interface Props {
  /** Готовый `<title>` (`buildTitle`): страница сама решает, нужен ли суффикс с именем сайта. */
  title: string;
  description: string;
  /** `false` — у страницы нет своего адреса (404): без canonical и `og:url`. */
  canonical?: boolean;
  /** Картинка превью; иначе `site.seo.defaultOgImage`, иначе без `og:image`. */
  ogImage?: ImageMetadata | undefined;
  /** Alt своей картинки страницы (`page.ogImageAlt`); к картинке сайта идёт alt сайта. */
  ogImageAlt?: string | undefined;
}

const { title, description, canonical = true, ogImage, ogImageAlt } = Astro.props;
const site = await getSite();

const url = canonical ? canonicalUrl(site.url, Astro.url.pathname) : undefined;

// Картинка и alt — из одной записи (страницы, продукта или сайта). OG-карточка — всегда PNG
// 1200×630: так её рисует build:og, требует целостность контента и принимает check-dist-seo
// (ep03). Размеры — исходного файла: getImage не масштабирует, а check-dist-seo сверяет их с
// файлом в сборке и держит вес ≤ 300 КБ.
// Перекодирование в PNG теряет палитру build:og (ep02 T13: 18 → 42 КБ) — запас большой, отдельной
// ветки «PNG без перекодирования» не нужно; если карточка потяжелеет, гейт упадёт раньше прода.
const preview = previewImage(
  { image: ogImage, alt: ogImageAlt },
  { image: site.seo.defaultOgImage, alt: site.seo.defaultOgImageAlt },
);
const image =
  preview === undefined
    ? undefined
    : {
        url: assetUrl(
          site.url,
          (await getImage({ src: preview.image, format: 'png' })).src,
        ),
        width: preview.image.width,
        height: preview.image.height,
        alt: preview.alt,
      };

const markSize = logoLayout('mark', maxLogoHeight('mark')).mark;
const logo = await getImage({ src: mark, format: 'png', width: markSize?.width, height: markSize?.height });
const jsonLd = serializeJsonLd(organizationJsonLd(site, assetUrl(site.url, logo.src)));
---

<title>{title}</title>
<meta name="description" content={description} />
{!indexable(SITE_ENV) && <meta name="robots" content="noindex, nofollow" />}
{url && <link rel="canonical" href={url} />}
{
  socialMeta({ title, description, siteName: site.name, url, image }).map(({ attr, key, content }) =>
    attr === 'property' ? <meta property={key} content={content} /> : <meta name={key} content={content} />,
  )
}
<script type="application/ld+json" set:html={jsonLd} is:inline />
