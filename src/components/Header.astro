---
// Шапка: знак — ссылка на главную, меню из `page.nav` (placement: header).
// Пустое меню не рендерит `<nav>`; без знака и меню шапки нет вовсе.
import Logo from './Logo.astro';
import { getNav, getSite } from '../lib/content';

interface Props {
  /** false — страница сама показывает знак крупно (заглушка), в шапке он не повторяется. */
  logo?: boolean;
}

const { logo = true } = Astro.props;
const site = await getSite();
const nav = await getNav('header');
const current = Astro.url.pathname;
---

{
  (logo || nav.length > 0) && (
    <header class="site-header">
      <div class="container site-header__inner">
        {logo && (
          <a class="site-header__home" href="/">
            <Logo variant="lockup" size={32} alt={site.name} />
          </a>
        )}
        {nav.length > 0 && (
          <nav aria-label="Основное меню">
            <ul class="site-header__nav" role="list">
              {nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </header>
  )
}

<style>
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md);
  }

  .site-header__home {
    --logo-height: var(--logo-header-h);

    display: inline-flex;
    border-radius: var(--radius-field);
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    padding: 0;
    list-style: none;
  }
</style>
