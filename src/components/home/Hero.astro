---
// Герой главной: плашка со знаком и слоганом (`HeroPlate`) и под ней, на основном фоне, —
// надзаголовок, лид, акцент и примечание из `pages/index.md → hero`. Мелкий текст на плашку
// не ставится: при рыжей плашке его контраст ниже 4.5 (выбор владельца 2026-09-26, T14).
import HeroPlate from './HeroPlate.astro';
import type { Page, Site } from '../../lib/content';

interface Props {
  page: Page;
  site: Site;
}

const { page, site } = Astro.props;
const hero = page.data.hero;
---

<section class="hero">
  <HeroPlate site={site} />
  {
    (hero?.eyebrow || hero?.lead || hero?.accent || hero?.note) && (
      <div class="container hero__intro">
        {hero?.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
        {hero?.lead && <p class="hero__lead">{hero.lead}</p>}
        {hero?.accent && <p class="hero__accent">{hero.accent}</p>}
        {hero?.note && <p class="hero__note">{hero.note}</p>}
      </div>
    )
  }
</section>

<style>
  .hero__intro {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    padding-block: var(--space-section) 0;
  }

  .hero__intro > * {
    max-width: var(--measure);
  }

  .hero__lead {
    font-size: var(--text-h3);
    line-height: var(--leading-snug);
  }

  .hero__accent {
    padding: var(--space-md) var(--space-lg);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    font-weight: var(--font-weight-bold);
  }

  .hero__note {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }
</style>
