---
// Выход из тупика. Сборка кладёт страницу в dist/404.html, nginx отдаёт её через error_page (T15).
// Текст — `pages/404.md`: `title` — в `<title>`, `hero.heading` — заголовок, ссылка — в теле.
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPage, getSite } from '../lib/content';
import { buildTitle } from '../lib/seo';

const site = await getSite();
const page = await getPage('404');
const { Content } = await render(page);
const { title, description, hero } = page.data;
---

<Base title={buildTitle(title, site.name)} description={description} canonical={false}>
  <section class="container not-found">
    <h1>{hero?.heading ?? title}</h1>
    {hero?.lead && <p>{hero.lead}</p>}
    <Content />
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    gap: var(--space-md);
    margin-block: auto;
    padding-block: var(--space-section);
  }

  .not-found > :global(*) {
    max-width: var(--measure);
  }
</style>
