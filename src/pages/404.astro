---
// Выход из тупика. Сборка кладёт страницу в dist/404.html, nginx отдаёт её через error_page (T15).
// Текст утверждён владельцем 2026-09-24 (гейт A); финальная 404 — ep02.
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/content';
import { buildTitle } from '../lib/seo';

const site = await getSite();
---

<Base
  title={buildTitle('Страница не найдена', site.name)}
  description="Такой страницы нет: возможно, адрес набран с ошибкой или страница ещё не опубликована."
  canonical={false}
>
  <section class="container not-found">
    <h1>Такой страницы нет</h1>
    <p>Возможно, адрес набран с ошибкой или страница ещё не опубликована.</p>
    <p><a href="/">На главную</a></p>
  </section>
</Base>

<style>
  .not-found {
    display: grid;
    gap: var(--space-md);
    margin-block: auto;
    padding-block: var(--space-section);
  }

  .not-found > * {
    max-width: var(--measure);
  }
</style>
