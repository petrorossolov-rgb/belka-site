---
// Страница продукта — полная или концепция, один шаблон: герой (`ProductHero`) и секции из
// `product.sections` (общий рендер `Sections.astro`). Тела у продукта со страницей нет
// (целостность контента). Маршруты — только продукты с `hasPage`, видимые в текущем
// окружении; черновая страница (`draft` продукта или `pageDraft`) — с маркером и плашкой.
import ProductHero from '../../components/product/ProductHero.astro';
import Sections from '../../components/sections/Sections.astro';
import Base from '../../layouts/Base.astro';
import { getProductPages, getProductSections, getSite, type Product } from '../../lib/content';
import { buildTitle, productTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const products = await getProductPages();
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const site = await getSite();
const sections = await getProductSections(product);
const { summary, seo, draft, pageDraft, ogImage, ogImageAlt } = product.data;
---

<Base
  title={buildTitle(productTitle(product.data), site.name)}
  description={seo?.description ?? summary}
  draft={draft || pageDraft}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <ProductHero product={product} />
  <Sections blocks={sections} />
</Base>
