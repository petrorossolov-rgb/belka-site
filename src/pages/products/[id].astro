---
// Минимальная страница продукта (ep01): имя, `short`, тело Markdown. Маршруты — только
// продукты с `hasPage`, видимые в текущем окружении; черновая страница (`draft` продукта
// или `pageDraft`) — с маркером и плашкой. Полный шаблон — ep03.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProductPages, getSite, type Product } from '../../lib/content';
import { buildTitle, productTitle } from '../../lib/seo';

export async function getStaticPaths() {
  const products = await getProductPages();
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const site = await getSite();
const { Content } = await render(product);
const { name, short, summary, seo, draft, pageDraft } = product.data;
---

<Base title={buildTitle(productTitle(product.data), site.name)} description={seo?.description ?? summary} draft={draft || pageDraft}>
  <article class="container product">
    <p class="eyebrow">{short}</p>
    <h1>{name}</h1>
    <Content />
  </article>
</Base>

<style>
  .product {
    display: grid;
    gap: var(--space-md);
    padding-block: var(--space-section);
  }

  .product > :global(*) {
    max-width: var(--measure);
  }
</style>
