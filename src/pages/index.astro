---
// Главная: герой из `pages/index.md → hero` и секции из `sections` — компонент по `view` блока.
// Карта видов типизирована `Record<BlockView, …>`: новый вид без компонента не пройдёт
// `astro check`. Шапки нет (знак крупно в герое, меню пустое), в подвале — только строка ©.
import CardGrid from '../components/home/CardGrid.astro';
import Hero from '../components/home/Hero.astro';
import PlatformMap from '../components/home/PlatformMap.astro';
import ProductCards from '../components/home/ProductCards.astro';
import Section from '../components/home/Section.astro';
import Steps from '../components/home/Steps.astro';
import Surfaces from '../components/home/Surfaces.astro';
import TermList from '../components/home/TermList.astro';
import TextBlock from '../components/home/TextBlock.astro';
import Base from '../layouts/Base.astro';
import { getPage, getSections, getSite, type Block } from '../lib/content';
import type { BlockView } from '../lib/schemas';
import { buildTitle } from '../lib/seo';

const VIEWS: Record<BlockView, (props: { block: Block }) => unknown> = {
  text: TextBlock,
  cards: CardGrid,
  steps: Steps,
  list: TermList,
  'platform-map': PlatformMap,
  products: ProductCards,
  surfaces: Surfaces,
};

const site = await getSite();
const page = await getPage('index');
const sections = await getSections(page);
const { title, description, draft, ogImage, ogImageAlt } = page.data;
---

<Base
  title={buildTitle(title, site.name, { home: true })}
  description={description}
  draft={draft}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  brandScreen
>
  <Hero page={page} site={site} />
  {
    sections.map((block) => {
      const View = VIEWS[block.data.view];
      return (
        <Section block={block}>
          <View block={block} />
        </Section>
      );
    })
  }
</Base>
