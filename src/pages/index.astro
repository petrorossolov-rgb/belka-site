---
// Главная: герой из `pages/index.md → hero` и секции из `sections` — общий рендер
// `Sections.astro` (компонент по `view` блока). Шапки нет (знак крупно в герое, меню
// пустое), в подвале — только строка ©.
import Hero from '../components/home/Hero.astro';
import Sections from '../components/sections/Sections.astro';
import Base from '../layouts/Base.astro';
import { getPage, getSections, getSite } from '../lib/content';
import { buildTitle } from '../lib/seo';

const site = await getSite();
const page = await getPage('index');
const sections = await getSections(page);
const { title, description, draft, ogImage, ogImageAlt } = page.data;
---

<Base
  title={buildTitle(title, site.name, { home: true })}
  description={description}
  draft={draft}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  brandScreen
>
  <Hero page={page} site={site} />
  <Sections blocks={sections} />
</Base>
